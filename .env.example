# Mẫu biến môi trường cho OpenCode / MCP (copy sang .env rồi điền giá trị thật)
# KHÔNG commit .env

# GitBook MCP server (https://mcp.gitbook.com/mcp) — PAT có quyền đọc/ghi space
GITBOOK_MCP_TOKEN=

# GitHub API (nếu dùng GitHub MCP / scripts/upload-image.sh)
GITHUB_TOKEN=

# Token push ảnh lên nqdev-storage/s3-001 (xem scripts/README.md)
S3_001_TOKEN=
